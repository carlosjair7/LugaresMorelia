{
  "expo": {
    "name": "Lugares Misteriosos",
    "slug": "lugaresmorelia",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#065f46"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.utm.lugaresmorelia"
    },
    "android": {
      "package": "com.utm.lugaresmorelia"
    },
    "plugins": [
      ["expo-camera", {
        "cameraPermission": "La app necesita la cámara para fotografiar lugares visitados."
      }],
      ["expo-location", {
        "locationWhenInUsePermission": "La app necesita tu ubicación para guardar coordenadas."
      }]
    ]
  }
}